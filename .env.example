# SQLite state store (relative to prisma/schema.prisma; absolute paths also work)
DATABASE_URL=file:./db/custom.db

# Lock-gate login (12h cookie session once entered).
FLEET_ADMIN_PASSWORD=fleet-demo-2026

# HMAC signing secrets for the admin cookie and the fls_ agent sessions.
FLEET_SESSION_SECRET=change-me-32-chars-minimum-secret
FLEET_AGENT_SESSION_SECRET=change-me-too-32-chars-minimum

# Default scopes granted to env agent links.
FLEET_AGENT_SCOPES=github:read,vercel:read

# Parent agent link — every fac_ temp password mints sessions that derive
# from (and die with) this link. Generate one: openssl rand -hex 24
# Format: flk_<hex>:<comma-separated scopes>
FLEET_AGENT_KEYS=flk_REPLACEME_WITH_openssl_rand_hex_24:github:read,vercel:read

# Provider tokens — prefer the in-app Token Vault (Integrations page).
# FLEET_GITHUB_TOKEN=
# FLEET_VERCEL_TOKEN=
# GITHUB_TOKEN=        (fleet repo metadata probes)
# INDEXNOW_KEY=        (public-by-design key served at /<key>.txt on fleet sites)
